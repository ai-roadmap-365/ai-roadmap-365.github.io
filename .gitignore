# Dependencies
node_modules/

# Build output
dist/
.astro/

# Environment / secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/

# Logs and caches
npm-debug.log*
*.log
# ...except the fixed sample data a lab's tests measure. Day 010's whole suite
# asserts known counts against this file, so if *.log swallows it the lab
# cannot run for anyone who cloned the repository.
!labs/sections/computing-foundations/day-010-working-with-text-cat-grep-sed/examples/samples/access.log
.cache/
coverage/

# git filter-branch scratch directory. It lives at the repository root while a
# rewrite runs, and an unguarded `git add -A` during one sweeps 232 temp files
# into a commit -- which is exactly what happened once.
.git-rewrite/

# Python lab virtualenvs (labs are run in place, envs are not versioned)
.venv/
.venv-tools/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
.pytest_cache/

# Lab runtime output — labs generate these when run and clean them with
# their own cleanup_commands; the captured evidence lives in expected-output/
labs/**/out/
labs/**/workspace/
# Databases a lab builds from its own seed script. The seed and the schema are
# the source; the .db file is output, and committing it would ship a binary
# blob the site can only render as "(binary file)". A lab that genuinely needs
# to SHIP a prepared database can force-add it.
labs/**/*.db
labs/**/*.sqlite
labs/**/*.sqlite3

# Local editor permission config — never commit (grants bypassPermissions on clone)
.vscode/settings.json
# Same reason. Previously covered only by a global git ignore, which does not
# travel with the repository; this keeps the protection local to the repo.
.claude/settings.local.json

# Browser-automation scratch output; never source.
.playwright-mcp/
