---
import Base from '../layouts/Base.astro';
---

<Base title="Search">
  <div class="readable">
    <h1>Search the course</h1>
    <form id="search-form" role="search">
      <label for="q">Search all written lessons (titles, text, glossary terms):</label>
      <div class="searchrow">
        <input type="search" id="q" name="q" placeholder="vectors, dot product, cron…" />
        <button class="btn btn--primary" type="submit">Search</button>
      </div>
    </form>
    <div id="results" aria-live="polite"></div>
  </div>

  <style>
    .searchrow {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
      margin: 12px 0 6px;
    }
    /* The field used to be an unstyled browser default, which on a dark page
       rendered as a bright white slab. It now uses the same surface, border and
       radius as every other control on the site. */
    .searchrow input {
      flex: 1 1 22rem;
      min-width: 0;
      font: inherit;
      color: var(--text);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 11px;
      padding: 12px 14px;
      transition:
        border-color 0.2s,
        box-shadow 0.2s;
    }
    .searchrow input::placeholder {
      color: var(--text-faint);
    }
    .searchrow input:focus {
      outline: none;
      border-color: var(--cyan);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--cyan) 22%, transparent);
    }
  </style>

  <script>
    interface IndexEntry {
      day: number;
      dayId: string;
      title: string;
      section: string;
      week: number;
      text: string;
    }
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    let index: IndexEntry[] | null = null;

    async function ensureIndex(): Promise<IndexEntry[]> {
      if (!index) {
        const res = await fetch(`${base}/search-index.json`);
        index = (await res.json()) as IndexEntry[];
      }
      return index;
    }

    function score(entry: IndexEntry, terms: string[]): number {
      let s = 0;
      const title = entry.title.toLowerCase();
      for (const t of terms) {
        if (title.includes(t)) s += 10;
        if (entry.text.includes(t)) s += 1;
      }
      return s;
    }

    const form = document.getElementById('search-form') as HTMLFormElement;
    const results = document.getElementById('results')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = (document.getElementById('q') as HTMLInputElement).value.trim().toLowerCase();
      if (!q) return;
      const terms = q.split(/\s+/);
      const idx = await ensureIndex();
      const hits = idx
        .map((entry) => ({ entry, s: score(entry, terms) }))
        .filter((h) => h.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 30);
      results.innerHTML = hits.length
        ? `<ol>${hits
            .map(
              (h) =>
                `<li><a href="${base}/${h.entry.dayId}">Day ${h.entry.day}: ${h.entry.title}</a> <span class="badge">${h.entry.section} · week ${h.entry.week}</span></li>`,
            )
            .join('')}</ol>`
        : '<p>No written lesson matches that query yet.</p>';
    });
  </script>
</Base>
