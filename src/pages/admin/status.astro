---
/**
 * Private course-status dashboard (requirements §18). Reads real repository
 * metadata: curriculum.yml, progress.yml, and on-disk artifact checks.
 * Excluded from public exports (the release pipeline copies only lesson
 * packages; nothing under /admin is ever selected).
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import { allDays, loadSidecars } from '../../lib/curriculum';
import { repoRoot } from '../../lib/config';
import { lessonContentPath, labPath } from '../../lib/links';

const days = allDays();
const authored = days.filter((d) => d.hasContent);
const complete = days.filter((d) => d.status === 'complete');
const draft = days.filter((d) => d.status === 'draft');
const inReview = days.filter((d) => d.status === 'in-review');
const labs = days.filter((d) => d.hasLab);
const readmes = days.filter(
  (d) =>
    existsSync(path.join(repoRoot, lessonContentPath(d), 'README.md')) &&
    existsSync(path.join(repoRoot, labPath(d), 'README.md')),
);

const today = new Date().toISOString().slice(0, 10);
const staleCutoffMs = 180 * 24 * 60 * 60 * 1000; // current-product content older than ~6 months
let sourcesVerified = 0;
let visualsComplete = 0;
const stale: number[] = [];
const missingCitations: number[] = [];
for (const d of authored) {
  const sc = loadSidecars(d);
  if ((sc.sources?.sources?.length ?? 0) >= 3) sourcesVerified += 1;
  else missingCitations.push(d.number);
  if ((sc.visuals?.visuals?.length ?? 0) >= 1) visualsComplete += 1;
  const verified = String(sc.lesson.last_verified ?? '');
  if (verified && Date.parse(today) - Date.parse(verified) > staleCutoffMs) stale.push(d.number);
}

const completionFlags = [
  'lesson_content',
  'lesson_rendered',
  'lab_created',
  'lab_executed',
  'tests_passed',
  'visuals_complete',
  'sources_verified',
  'readme_complete',
  'local_links_passed',
  'lab_links_generated',
  'blog_published',
  'privacy_scan_passed',
  'editorial_review_passed',
];
const releaseReady = complete.filter((d) => {
  const c = (d as unknown as { completion?: Record<string, boolean> }).completion ?? {};
  return completionFlags.every((f) => c[f] === true);
});

const lastComplete = complete.at(-1);
const nextIncomplete = days.find((d) => d.status !== 'complete');
const rows: [string, string][] = [
  ['Total lessons', String(days.length)],
  ['Lessons written (content on disk)', `${authored.length} / ${days.length}`],
  ['Lessons validated complete', `${complete.length} / ${days.length}`],
  ['Draft lessons', String(draft.length)],
  ['Lessons requiring review', String(inReview.length)],
  ['Labs created', `${labs.length} / ${days.length}`],
  ['Daily READMEs complete (lesson + lab)', `${readmes.length} / ${days.length}`],
  ['Sources verified (≥3 real citations)', `${sourcesVerified} / ${authored.length} written`],
  ['Visuals complete', `${visualsComplete} / ${authored.length} written`],
  ['Public-release-ready lessons (all 13 flags true)', String(releaseReady.length)],
  ['Stale current-product lessons (verified > 6 months ago)', stale.length ? stale.join(', ') : 'none'],
  ['Written lessons missing citations', missingCitations.length ? `days ${missingCitations.join(', ')}` : 'none'],
  ['Last completed day', lastComplete ? `Day ${lastComplete.number}: ${lastComplete.title}` : '—'],
  ['Next incomplete day', nextIncomplete ? `Day ${nextIncomplete.number}: ${nextIncomplete.title}` : 'course complete'],
];
---

<Base title="Course status (private)">
  <div class="readable">
    <h1>Course status dashboard</h1>
  <p class="callout">
    <strong>Private.</strong> This page reads live repository metadata (curriculum, progress
    tracker, on-disk artifacts). It is never included in public exports. Tests-passing and
    link-check states come from running <code>npm run verify:all</code>; a day is marked
    <em>complete</em> in <code>curriculum/progress.yml</code> only after all thirteen completion
    flags pass validation (requirements §13).
  </p>
  <table>
    <tbody>
        {rows.map(([label, value]) => <tr><th>{label}</th><td>{value}</td></tr>)}
      </tbody>
    </table>
  </div>
</Base>
