---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allDays, getDay, type DayContext } from '../../lib/curriculum';
import { loadLab, readLabFile } from '../../lib/labs';
import { loadConfig } from '../../lib/config';
import { getPublicRepoLabUrl } from '../../lib/links';
import { renderMarkdown } from '../../lib/markdown';
import StarCta from '../../components/StarCta.astro';

export function getStaticPaths() {
  return allDays()
    .filter((d) => d.hasLab)
    .map((d) => ({ params: { day: d.dayId }, props: { number: d.number } }));
}

const { number } = Astro.props;
const day = getDay(number) as DayContext;
const lab = loadLab(day);
if (!lab) throw new Error(`Lab for day ${number} disappeared between getStaticPaths and render.`);
const config = loadConfig();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Embedded docs bring their own h1s; demote all headings one level so the
// page keeps a single h1 and a sane outline.
const demote = (md: string) => md.replace(/^(#{1,5}) /gm, '#$1 ');
const readmeHtml = await renderMarkdown(demote(lab.readme));
const troubleshootingHtml = lab.troubleshooting
  ? await renderMarkdown(demote(lab.troubleshooting))
  : null;
const securityHtml = lab.security ? await renderMarkdown(demote(lab.security)) : null;

// Inline viewer for every text source file in the lab (excluding files
// already shown in dedicated sections).
const skip = new Set(['README.md', 'troubleshooting.md', 'security.md']);
const sourceFiles = lab.files
  .filter((f) => !skip.has(f.relPath) && !f.relPath.startsWith('expected-output/'))
  .map((f) => ({ ...f, content: readLabFile(day, f.relPath) ?? '(binary file)' }));
---

<Base title={`Lab · Day ${day.number}: ${day.title}`}>
  <article class="readable">
    <Breadcrumbs day={day} />
  <h1>Hands-on lab — Day {day.number}: {day.title}</h1>

  <div class="callout">
    <ul>
      <li><a href={`${base}/${day.dayId}`}>← Back to the Day {day.number} lesson</a></li>
      <li>
        <a href={getPublicRepoLabUrl(config, day)} target="_blank" rel="noopener noreferrer">Open the hands-on files on GitHub</a>
        — clone or download them from the public labs repository
      </li>
      <li>Local path in your clone: <code>{`labs/sections/${day.section}/${day.dayId}/`}</code></li>
    </ul>
  </div>

  {
    lab.metadata && (
      <>
        <h2 id="commands">Commands</h2>
        {/*
          A day still being authored can have a metadata.yml without every
          command list yet. Rendering what is present beats crashing the whole
          build over one in-flight day; validate:labs is what enforces that a
          FINISHED day has all three.
        */}
        <h3>Setup</h3>
        <pre><code>{(lab.metadata.setup_commands ?? []).join('\n')}</code></pre>
        <h3>Run</h3>
        <pre><code>{(lab.metadata.run_commands ?? []).join('\n')}</code></pre>
        <h3>Test</h3>
        <pre><code>{(lab.metadata.test_commands ?? []).join('\n')}</code></pre>
      </>
    )
  }

  <h2 id="file-tree">File tree</h2>
  <pre class="file-tree">{lab.files.map((f) => f.relPath).join('\n')}</pre>

  <h2 id="readme">Lab README</h2>
  <div set:html={readmeHtml} />

  {
    lab.expectedOutput.length > 0 && (
      <>
        <h2 id="expected-output">Expected output</h2>
        {lab.expectedOutput.map((e) => (
          <>
            <h3>{e.name}</h3>
            <pre><code>{e.content}</code></pre>
          </>
        ))}
      </>
    )
  }

  <h2 id="source-files">Source files</h2>
  {
    sourceFiles.map((f) => (
      <details class="quiz-question">
        <summary>
          <code>{f.relPath}</code> ({f.size} bytes)
        </summary>
        <pre><code>{f.content}</code></pre>
      </details>
    ))
  }

  {
    troubleshootingHtml && (
      <>
        <h2 id="troubleshooting">Troubleshooting</h2>
        <div set:html={troubleshootingHtml} />
      </>
    )
  }

  {
    securityHtml && (
      <>
        <h2 id="security">Security notes</h2>
        <div set:html={securityHtml} />
      </>
    )
  }
  <StarCta context="lab" />
  </article>
</Base>
