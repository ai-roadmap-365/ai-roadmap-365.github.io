---
import Base from '../../layouts/Base.astro';
import { loadCurriculum, allDays } from '../../lib/curriculum';

const curriculum = loadCurriculum();
// Only days that actually have a lab directory get a /labs/<day> route in
// ./[day].astro, so filtering the same way keeps every link here resolvable.
const labDays = allDays().filter((d) => d.hasLab);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Hands-on labs">
  <div class="readable">
    <h1>Hands-on labs</h1>
    <p>
      Every day ships a runnable lab: starter files, the commands to set it up and run it, the
      expected output, and troubleshooting notes. {labDays.length} labs in total.
    </p>
    {
      curriculum.sections.map((section) => {
        const days = labDays.filter((d) => d.section === section.slug);
        if (days.length === 0) return null;
        return (
          <details class="quiz-question">
            <summary>
              {section.id} · {section.title} <span class="badge">{days.length} labs</span>
            </summary>
            <ul>
              {days.map((d) => (
                <li>
                  <a href={`${base}/labs/${d.dayId}`}>
                    Day {d.number}: {d.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        );
      })
    }
  </div>
</Base>
