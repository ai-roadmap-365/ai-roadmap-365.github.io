---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import Base from '../../layouts/Base.astro';
import { repoRoot } from '../../lib/config';

interface CatalogDoc {
  title: string;
  description: string;
  entries: unknown[];
}

// Kept in step with getStaticPaths in ./[catalog].astro -- one entry per
// catalog/<slug>.yml. A slug added there without a line here still builds and
// is simply absent from this index, which is why validate:links checks both.
const slugs = ['tools', 'frameworks', 'models', 'projects', 'free-open-source'];

const catalogs = slugs.map((slug) => {
  const doc = yaml.load(
    readFileSync(path.join(repoRoot, 'catalog', `${slug}.yml`), 'utf8'),
  ) as CatalogDoc;
  return { slug, title: doc.title, description: doc.description, count: doc.entries.length };
});

const total = catalogs.reduce((sum, c) => sum + c.count, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Catalogs">
  <div class="readable">
    <h1>Catalogs</h1>
    <p>
      Every tool, framework, model and project referenced across the 365 days, with its licence,
      pricing and the date the entry was last verified. {total} entries across {catalogs.length} catalogs.
    </p>
    {
      catalogs.map((c) => (
        <section>
          <h2>
            <a href={`${base}/catalog/${c.slug}`}>{c.title}</a>
          </h2>
          <p>{c.description}</p>
          <p>
            <span class="badge">{c.count} entries</span>
          </p>
        </section>
      ))
    }
  </div>
</Base>
