---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import yaml from 'js-yaml';
import Base from '../../layouts/Base.astro';
import { repoRoot } from '../../lib/config';

interface CatalogEntry {
  name: string;
  url: string;
  category: string;
  license: string;
  pricing: string;
  notes: string;
  last_verified: string;
}

interface CatalogDoc {
  title: string;
  description: string;
  entries: CatalogEntry[];
}

export function getStaticPaths() {
  return ['tools', 'frameworks', 'models', 'projects', 'free-open-source'].map((c) => ({
    params: { catalog: c },
  }));
}

const { catalog } = Astro.params;
const doc = yaml.load(
  readFileSync(path.join(repoRoot, 'catalog', `${catalog}.yml`), 'utf8'),
) as CatalogDoc;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const catalogs = [
  ['tools', 'Tools'],
  ['frameworks', 'Frameworks'],
  ['models', 'Models'],
  ['projects', 'Projects'],
  ['free-open-source', 'Free & open source'],
];
---

<Base title={doc.title}>
  <div class="readable">
    <h1>{doc.title}</h1>
  <p class="crumbs">
    Catalogs:{' '}
    {catalogs.map(([slug, label]) => (slug === catalog ? <strong>{label}</strong> : <a href={`${base}/catalog/${slug}`}>{label}</a>))}
  </p>
  <p>{doc.description}</p>
  <table>
    <thead>
      <tr><th>Name</th><th>Category</th><th>License</th><th>Pricing</th><th>Notes</th><th>Verified</th></tr>
    </thead>
    <tbody>
      {
        doc.entries.map((e) => (
          <tr>
            <td><a href={e.url}>{e.name}</a></td>
            <td>{e.category}</td>
            <td>{e.license}</td>
            <td>{e.pricing}</td>
            <td>{e.notes}</td>
            <td>{e.last_verified}</td>
          </tr>
        ))
      }
      </tbody>
    </table>
  </div>
</Base>
