---
import Base from '../layouts/Base.astro';
import StarCta from '../components/StarCta.astro';
import { loadCurriculum, allDays } from '../lib/curriculum';

const curriculum = loadCurriculum();
const days = allDays();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const written = days.filter((d) => d.hasContent).length;
const labs = days.filter((d) => d.hasLab).length;
const firstAuthored = days.find((d) => d.hasContent);
const latestAuthored = [...days].reverse().find((d) => d.hasContent);

// Per-course progress, computed from the curriculum and what is on disk.
// Nothing here is hand-typed, so the page cannot drift from reality.
const sections = curriculum.sections.map((section) => {
  const sectionDays = days.filter((d) => d.section === section.slug);
  const done = sectionDays.filter((d) => d.hasContent).length;
  return {
    ...section,
    days: sectionDays,
    written: done,
    total: sectionDays.length,
    pct: sectionDays.length ? Math.round((done / sectionDays.length) * 100) : 0,
  };
});

const RING_R = 24;
const RING_C = 2 * Math.PI * RING_R;
---

<Base title="365 Days of AI Mastery — a year-long, hands-on path" bareTitle>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <linearGradient id="ringgrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#6f6cf6"></stop>
        <stop offset="1" stop-color="#38bdf8"></stop>
      </linearGradient>
    </defs>
  </svg>

  <section class="hero wrap">
    <span class="chip">
      <span class="chip__dot"></span>
      {written} of {curriculum.course.days} lessons written · {labs} labs released
    </span>

    {/* One clause per line. Left to wrap on its own the headline broke as
        "One year. Nine / courses. One lesson / each day.", splitting a phrase
        across lines and burying the gradient mid-sentence. */}
    <h1>
      <span class="hline">One year.</span>
      <span class="hline grad">Nine courses.</span>
      <span class="hline">One lesson each day.</span>
    </h1>

    <p class="hero__sub">
      A complete, self-paced path from how a computer actually works to shipping production AI
      systems — one substantial lesson and one hands-on lab every single day. No prerequisites
      beyond curiosity, and every lab runs on free and open-source tools.
    </p>

    <div class="hero__cta">
      {
        firstAuthored && (
          <a class="btn btn--primary" href={`${base}/${firstAuthored.dayId}`}>
            Start with Day {firstAuthored.number}
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        )
      }
      <a class="btn" href="#courses">Browse the nine courses</a>
      {
        latestAuthored && latestAuthored.number !== firstAuthored?.number && (
          <a class="btn" href={`${base}/${latestAuthored.dayId}`}>
            Latest: Day {latestAuthored.number}
          </a>
        )
      }
    </div>

  </section>

  {/* The animated map of the year leads the page, above the counters: it is the
      one picture that explains the whole thing, and a visitor should see where
      the year goes before reading how many days are in it. The counters follow
      it as supporting detail rather than preceding it as a wall of numbers. */}
  <section class="wrap section" id="journey">
    <div class="section__head">
      <h2>The whole year, end to end</h2>
      <p class="eyebrow">where this takes you</p>
    </div>
    <img
      class="journey"
      src={`${base}/journey.svg`}
      width="1200"
      height="300"
      alt="The 365-day journey: nine courses on one path, from Computing Foundations on Day 1 through Python, maths, machine learning, deep learning, large language models, AI engineering and deployment, to shipping your own capstone on Day 365"
    />
    <div class="stats">
      <div class="stat"><b>{curriculum.course.days}</b><span>days</span></div>
      <div class="stat"><b>{curriculum.course.weeks}</b><span>weeks</span></div>
      <div class="stat"><b>{curriculum.sections.length}</b><span>courses</span></div>
      <div class="stat"><b>{written}</b><span>lessons written</span></div>
      <div class="stat"><b>{labs}</b><span>labs released</span></div>
    </div>
  </section>

  <section class="wrap section" id="courses">
    <div class="section__head">
      <h2>The nine courses</h2>
      <p class="eyebrow">foundations → production</p>
    </div>

    <div class="courses">
      {
        sections.map((section) => {
          const dash = (RING_C * section.pct) / 100;
          return (
            <article class={`course reveal${section.written === 0 ? ' course--planned' : ''}`}>
              <svg class="ring" viewBox="0 0 56 56" aria-hidden="true">
                <circle class="track" cx="28" cy="28" r={RING_R} />
                {/* At 0% a round line-cap still paints a dot, which reads as
                    "a little progress" when there is none. */}
                {section.pct > 0 && (
                  <circle
                    class="fill"
                    cx="28"
                    cy="28"
                    r={RING_R}
                    stroke-dasharray={`${dash} ${RING_C}`}
                  />
                )}
                <text x="28" y="33">{section.pct}</text>
              </svg>
              <div class="course__body">
                <span class="course__id">
                  {section.id} · {section.written}/{section.total} written
                </span>
                <h3 class="course__title">
                  <a class="course__link" href={`${base}/sections/${section.slug}`}>
                    {section.title}
                  </a>
                </h3>
                <p class="course__sum">{section.summary}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="section__head">
      <h2>How this works</h2>
      <p class="eyebrow">what you get each day</p>
    </div>

    <div class="courses">
      <article class="course reveal">
        <div class="course__body">
          <h3 class="course__title">A lesson you can read in one sitting</h3>
          <p class="course__sum">
            Written prose, not slides — with worked examples, a quiz to check yourself, and a
            glossary of every term it introduces.
          </p>
        </div>
      </article>
      <article class="course reveal">
        <div class="course__body">
          <h3 class="course__title">A lab you actually run</h3>
          <p class="course__sum">
            Starter files with numbered exercises, a reference implementation, automated tests that
            exit zero when you are done, and genuinely captured expected output.
          </p>
        </div>
      </article>
      <article class="course reveal">
        <div class="course__body">
          <h3 class="course__title">Honest progress</h3>
          <p class="course__sum">
            Days that are titled but not yet written are marked planned, never dressed up as
            finished. The counters above are computed from what is actually on disk.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="wrap section">
    <StarCta context="home" />
  </section>

  <section class="wrap section" id="curriculum">
    <div class="section__head">
      <h2>The full curriculum</h2>
      <p class="eyebrow">every day, in order</p>
    </div>

    {/* Collapsed by default. Every course is now written, so `open` on written
        sections expanded all nine at once and buried the page under 365 links.
        The reader opens the one they want. */}
    {
      sections.map((section) => (
        <details class="acc">
          <summary>
            {section.title}
            <span class="acc__count">
              {section.written}/{section.total}
            </span>
          </summary>
          <div class="acc__inner">
            {section.subsections.map((sub) => (
              <div class="weekgroup">
                <h3>{sub.title}</h3>
                <div class="daylist">
                  {sub.weeks.flatMap((week) =>
                    week.days.map((day) => {
                      const ctx = days.find((d) => d.number === day.number);
                      if (ctx?.hasContent) {
                        return (
                          <a class="day" href={`${base}/${ctx.dayId}`}>
                            <span class="day__n">{day.number}</span>
                            <span>{day.title}</span>
                          </a>
                        );
                      }
                      return (
                        <span class="day day--planned">
                          <span class="day__n">{day.number}</span>
                          <span>{day.title}</span>
                        </span>
                      );
                    }),
                  )}
                </div>
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </section>

  <style>
    /* This section leads the page now, so it sits closer to the hero than the
       standard section rhythm. */
    #journey {
      padding-top: 26px;
    }
    .journey {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: #0b1220;
    }
  </style>
</Base>
