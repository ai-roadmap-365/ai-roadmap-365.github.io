---
import Base from '../layouts/Base.astro';
import { authoredDays, loadSidecars } from '../lib/curriculum';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries: { term: string; definition: string; day: number; dayId: string; title: string }[] = [];
for (const day of authoredDays()) {
  const sidecars = loadSidecars(day);
  for (const t of sidecars.glossary?.terms ?? []) {
    entries.push({ ...t, day: day.number, dayId: day.dayId, title: day.title });
  }
}
entries.sort((a, b) => a.term.localeCompare(b.term));
---

<Base title="Glossary">
  <div class="readable">
    <h1>Glossary</h1>
  <p>
    Every term defined across the written lessons ({entries.length} terms so far). Each entry links
    to the lesson that introduced it. The glossary grows as lessons are written.
  </p>
  <dl>
    {
      entries.map((e) => (
        <>
          <dt>
            <strong>{e.term}</strong>{' '}
            <a class="badge" href={`${base}/${e.dayId}`}>
              Day {e.day}
            </a>
          </dt>
          <dd>{e.definition}</dd>
        </>
      ))
    }
    </dl>
  </div>
</Base>
