---
import Base from '../../../layouts/Base.astro';
import DayList from '../../../components/DayList.astro';
import { loadCurriculum, allDays } from '../../../lib/curriculum';

export function getStaticPaths() {
  return loadCurriculum().sections.map((s) => ({ params: { section: s.slug } }));
}

const { section: sectionSlug } = Astro.params;
const section = loadCurriculum().sections.find((s) => s.slug === sectionSlug)!;
const days = allDays().filter((d) => d.section === section.slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Days grouped into categories (the curriculum's week themes are the category
// labels; the directory structure is flat). Each category is a coherent run
// of lessons shown under a "Days X-Y · Theme" heading.
const groups = section.subsections
  .flatMap((sub) => sub.weeks)
  .map((week) => {
    const wkDays = days.filter((d) => d.week === week.number);
    return { theme: week.theme, project: week.project, days: wkDays };
  })
  .filter((g) => g.days.length > 0);
---

<Base title={section.title}>
  <div class="readable">
    <p class="crumbs"><a href={`${base}/sections`}>Courses</a> › {section.id}</p>
  <h1>{section.id} · {section.title}</h1>
  <p>{section.summary}</p>
  <p>
    <span class="badge">{days.length} days</span>
    <span class="badge">{days.filter((d) => d.hasContent).length} written</span>
    <span class="badge">{days.filter((d) => d.status === 'complete').length} complete</span>
  </p>

  {
    groups.map((g, i) => {
      const first = g.days[0].number;
      const last = g.days[g.days.length - 1].number;
      const done = g.days.filter((d) => d.status === 'complete').length;
      // Expand the first category that still has unwritten days.
      const openIdx = groups.findIndex((x) => x.days.some((d) => d.status !== 'complete'));
      return (
        <details open={i === openIdx} class="category">
          <summary>
            <strong>Days {first}-{last} · {g.theme}</strong>{' '}
            <span class="badge">{done}/{g.days.length} complete</span>
          </summary>
          <DayList days={g.days} />
          <p><strong>Project:</strong> {g.project.title} — {g.project.summary}</p>
        </details>
        );
      })
    }
  </div>
</Base>
