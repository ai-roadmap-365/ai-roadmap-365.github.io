---
import Base from '../../layouts/Base.astro';
import { loadCurriculum, allDays } from '../../lib/curriculum';

const curriculum = loadCurriculum();
const days = allDays();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Courses">
  <div class="readable">
    <h1>Courses</h1>
    {
    curriculum.sections.map((section) => {
      const sectionDays = days.filter((d) => d.section === section.slug);
      const written = sectionDays.filter((d) => d.hasContent).length;
      const weeks = section.subsections.flatMap((b) => b.weeks);
      return (
        <section>
          <h2>
            <a href={`${base}/sections/${section.slug}`}>
              {section.id} · {section.title}
            </a>
          </h2>
          <p>{section.summary}</p>
          <p>
            <span class="badge">{weeks.length} weeks</span>{' '}
            <span class="badge">{sectionDays.length} days</span>{' '}
            <span class="badge">{written} written</span>
          </p>
        </section>
        );
      })
    }
  </div>
</Base>
