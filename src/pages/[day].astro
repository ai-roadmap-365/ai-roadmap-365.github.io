---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';
import StarCta from '../components/StarCta.astro';
import Quiz from '../components/Quiz.astro';
import { loadConfig } from '../lib/config';
import { getDay, prevNext, loadSidecars, type DayContext } from '../lib/curriculum';
import { getLocalLabUrl } from '../lib/links';
// @ts-ignore -- shared plain-ESM lab-usage helpers
import { labUsageSteps, lessonDuration } from '../../scripts/lib/lab-usage.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => {
    const day = getDay(entry.data.day);
    if (!day) throw new Error(`Lesson frontmatter day ${entry.data.day} is not in the curriculum.`);
    return { params: { day: day.dayId }, props: { entry, number: entry.data.day } };
  });
}

const { entry, number } = Astro.props;
const day = getDay(number) as DayContext;
const { prev, next } = prevNext(number);
const sidecars = loadSidecars(day);
const lesson = sidecars.lesson as Record<string, string | number | string[]>;
const config = loadConfig();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
const objectives = (lesson.objectives ?? []) as string[];
// Prerequisites come in two shapes across the course: a plain string, or an
// object naming the day it refers to. Rendering the object form directly
// produced "[object Object]" on every page that used it, so normalise here and
// turn a referenced day into a link rather than dropping the information.
type PrereqEntry = string | { day?: number; slug?: string; title?: string };
const prerequisites = ((lesson.prerequisites ?? []) as unknown as PrereqEntry[]).map((p) => {
  if (typeof p === 'string') return { label: p, href: null as string | null };
  const label = [p.day ? `Day ${p.day}` : null, p.title].filter(Boolean).join(' — ');
  const href = p.slug ? `${base}/${p.slug}` : null;
  return { label: label || String(p.title ?? ''), href };
});
const duration = lessonDuration(sidecars);
const usage = labUsageSteps(config, day) as {
  repoUrl: string | null;
  rel: string;
  steps: { title: string; body: string; code?: string }[];
};
---

<Base
  title={`Day ${day.number}: ${day.title}`}
  description={String(lesson.learning_promise ?? day.title)}
  image={`social/${day.dayId}.png`}
>
  <article data-day={day.number}>
    <Breadcrumbs day={day} />
    <h1>Day {day.number}: {day.title}</h1>
    {/*
      The hero is the page's first image AND its og:image. Sharing the link is
      the normal way this page travels, and a crawler takes the first/declared
      image — so one file serves both and the preview cannot drift from the page.
    */}
    <img
      class="day-hero"
      src={`${base}/social/${day.dayId}.png`}
      width="1200"
      height="630"
      alt={`Day ${day.number} of 365 — ${day.title}`}
    />
    <p><em>{lesson.learning_promise}</em></p>

    <div class="meta-grid">
      <div><span class="label">Course</span><br />{day.sectionTitle}</div>
      <div><span class="label">Category</span><br />{day.weekTheme}</div>
      <div><span class="label">Reading time</span><br />≈ {lesson.reading_time_minutes} min</div>
      <div><span class="label">Practical time</span><br />≈ {lesson.practical_time_minutes} min</div>
      <div><span class="label">Lesson duration</span><br />{duration}</div>
      <div><span class="label">Last verified</span><br />{lesson.last_verified}</div>
    </div>

    {
      lesson.video_url && (
        <p>
          <strong>
            <a href={String(lesson.video_url)} target="_blank" rel="noopener noreferrer">▶ Watch the video for this lesson</a>
          </strong>{' '}
          — same content, demonstrated on screen.
        </p>
      )
    }

    <div class="callout">
      <h2 id="hands-on-lab" style="margin-top:0">Hands-on lab for this lesson</h2>
      {
        usage.repoUrl && (
          <p>
            <strong>Lab files on GitHub:</strong>{' '}
            <a href={usage.repoUrl} target="_blank" rel="noopener noreferrer">{usage.repoUrl}</a>
          </p>
        )
      }
      <ol>
        {
          usage.steps.map((s) => (
            <li>
              <strong>{s.title}.</strong> {s.body}
              {s.code && <pre><code>{s.code}</code></pre>}
            </li>
          ))
        }
      </ol>
      <p class="no-print">
        You can also <a href={getLocalLabUrl(config, day).replace(config.website.local_base_url, base)} target="_blank" rel="noopener noreferrer">open the lab as a local page</a> (works offline, shows the file tree and expected output).
      </p>
    </div>

    <h2 id="learning-objectives">Learning objectives</h2>
    <p>By the end of this lesson you will be able to:</p>
    <ul>{objectives.map((o) => <li>{o}</li>)}</ul>

    <h2 id="prerequisites">Prerequisites</h2>
    <ul>
      {prerequisites.map((p) => <li>{p.href ? <a href={p.href}>{p.label}</a> : p.label}</li>)}
    </ul>

    <Content />

    {
      sidecars.quiz && (
        <>
          <h2 id="quiz">Quiz</h2>
          <Quiz questions={sidecars.quiz.questions} />
        </>
      )
    }

    {
      sidecars.glossary && (
        <>
          <h2 id="glossary">Glossary</h2>
          <dl>
            {sidecars.glossary.terms.map((t) => (
              <>
                <dt>
                  <strong>{t.term}</strong>
                </dt>
                <dd>{t.definition}</dd>
              </>
            ))}
          </dl>
        </>
      )
    }

    {
      sidecars.sources && (
        <>
          <h2 id="sources">Sources and further reading</h2>
          <ul>
            {sidecars.sources.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> — {s.publisher} (accessed {s.accessed}){s.note ? ` — ${s.note}` : ''}
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="no-print">
      <label>
        <input type="checkbox" id="mark-complete" data-day={day.number} />
        Mark Day {day.number} as read
      </label>
      <br />
      <span class="marknote"
        >Kept in this browser, no account needed. <a href={`${base}/progress`}>Your progress page</a
        > turns the whole record into one link you can bookmark or open on another device.</span
      >
    </p>

    <StarCta />

    <PrevNext prev={prev} next={next} />
  </article>

  <script>
    const box = document.getElementById('mark-complete') as HTMLInputElement | null;
    if (box) {
      const key = 'ai-roadmap-read-days';
      const read = new Set<number>(JSON.parse(localStorage.getItem(key) ?? '[]'));
      const dayNum = Number(box.dataset.day);
      box.checked = read.has(dayNum);
      box.addEventListener('change', () => {
        if (box.checked) read.add(dayNum);
        else read.delete(dayNum);
        localStorage.setItem(key, JSON.stringify([...read].sort((a, b) => a - b)));
        // Ask the browser not to evict this under storage pressure. It may
        // decline, so nothing on the page depends on the answer.
        navigator.storage?.persist?.().catch(() => {});
      });
    }
  </script>

  <style>
    .marknote {
      display: inline-block;
      margin-top: 4px;
      font-size: 13.5px;
      color: var(--text-faint);
    }
    /* The hero carries the day number and the challenge branding, so it is the
       page's opening image and the one a shared link previews. */
    .day-hero {
      width: 100%;
      height: auto;
      border-radius: 12px;
      border: 1px solid var(--border, #1e293b);
      margin: 0 0 1.5rem;
      display: block;
    }
  </style>
</Base>
