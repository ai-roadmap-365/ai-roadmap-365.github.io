---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found">
  <div class="readable">
    <h1>Page not found</h1>
    <p>
      That page does not exist (yet). Days shown as <span class="badge planned">planned</span> in the
      curriculum have no page until their lesson is written.
    </p>
    <p><a href={`${base}/`}>Back to the course home</a> · <a href={`${base}/search`}>Search</a></p>
  </div>
</Base>
