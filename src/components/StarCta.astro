---
/**
 * A quiet ask, at the end of something the reader has just finished.
 *
 * Placed after the lesson rather than before it, and phrased as what a star
 * does for other people rather than what it does for the author — someone
 * looking for a free, hands-on AI course has no way to find this unless it
 * ranks, and a star is the only signal GitHub gives them. It is one line, it
 * is skippable, and it does not nag or pop up.
 */
import { loadConfig } from '../lib/config';

interface Props {
  /**
   * The ask is phrased for where the reader actually is. On the homepage they
   * have not read anything yet, so "if this lesson was useful" would be
   * nonsense; on a lab page they have just run something.
   */
  context?: 'lesson' | 'lab' | 'home';
}

const { context = 'lesson' } = Astro.props;
const config = loadConfig();
const repo = config.repository.url;

const line = {
  lab: 'If this lab ran and taught you something, a star helps the next person find it.',
  lesson: 'If this lesson was useful, a star helps the next person find it.',
  home: 'Like the look of this? A star helps the next person find it.',
}[context];
---

<aside class="starcta">
  <div class="starcta__text">
    <strong>{line}</strong>
    <span
      >The whole course is free and open source. Starring the repository is the only way it
      surfaces for someone searching for one — it costs you a click and it is genuinely how people
      find this.</span
    >
  </div>
  <a class="starcta__btn" href={repo} target="_blank" rel="noopener noreferrer">
    ★ Star on GitHub
  </a>
</aside>

<style>
  .starcta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin: 40px 0 8px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius, 12px);
    background: color-mix(in srgb, var(--accent, #1d4ed8) 7%, transparent);
  }
  .starcta__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 62ch;
  }
  .starcta__text span {
    font-size: 0.92rem;
    color: var(--muted, #94a3b8);
  }
  .starcta__btn {
    flex: none;
    padding: 11px 20px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    background: var(--accent, #1d4ed8);
    color: #fff;
    white-space: nowrap;
  }
  .starcta__btn:hover {
    filter: brightness(1.12);
  }
</style>
