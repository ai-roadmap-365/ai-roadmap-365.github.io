---
/**
 * A quiet ask, at the end of something the reader has just finished.
 *
 * Placed after the lesson rather than before it, and phrased as what a star
 * does for other people rather than what it does for the author — someone
 * looking for a free, hands-on AI course has no way to find this unless it
 * ranks, and a star is the only signal GitHub gives them. It is one line, it
 * is skippable, and it does not nag or pop up.
 */
import { loadConfig } from '../lib/config';

interface Props {
  /**
   * The ask is phrased for where the reader actually is. On the homepage they
   * have not read anything yet, so "if this lesson was useful" would be
   * nonsense; on a lab page they have just run something.
   */
  context?: 'lesson' | 'lab' | 'home';
}

const { context = 'lesson' } = Astro.props;
const config = loadConfig();
// One public repository, so the star goes to it (A48). `star_url` used to
// override this to point at a second copy, which split the star count across
// two repositories showing the same course; the override is gone from the
// config and the fallback is now the path always taken. The key is still
// honoured so a future override needs no code change.
const repo = config.repository.star_url ?? config.repository.url;

const line = {
  lab: 'If this lab ran and taught you something, a star helps the next person find it.',
  lesson: 'If this lesson was useful, a star helps the next person find it.',
  home: 'Like the look of this? A star helps the next person find it.',
}[context];
---

<aside class="starcta">
  <div class="starcta__text">
    <strong>{line}</strong>
    <span
      >The whole course is free and open source. Starring the repository is the only way it
      surfaces for someone searching for one — it costs you a click and it is genuinely how people
      find this.</span
    >
  </div>
  <a class="starcta__btn" href={repo} target="_blank" rel="noopener noreferrer">
    {/* The star is drawn rather than typed so it can fill on hover. It is
        decorative — the button already says what it does — so it is hidden
        from assistive technology instead of being announced as "black star". */}
    <svg class="starcta__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 2.6 l2.9 5.9 6.5 0.95 -4.7 4.58 1.11 6.47 -5.81-3.06 -5.81 3.06 1.11-6.47 -4.7-4.58 6.5-0.95 z"
      ></path>
    </svg>
    Star on GitHub
  </a>
</aside>

<style>
  .starcta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin: 40px 0 8px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius, 12px);
    background: color-mix(in srgb, var(--accent, #1d4ed8) 7%, transparent);
  }
  .starcta__text {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 62ch;
  }
  .starcta__text span {
    font-size: 0.92rem;
    color: var(--muted, #94a3b8);
  }
  .starcta__btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 20px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    background: var(--accent, #1d4ed8);
    color: #fff;
    white-space: nowrap;
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }
  .starcta__btn:hover,
  .starcta__btn:focus-visible {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  /* The star is an outline at rest and fills when the button is engaged, which
     is the same gesture the README button animates. It is drawn empty rather
     than gold so that filling means something; the outline is legible either
     way, so nothing is lost when the motion is switched off. */
  .starcta__star {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: #f5b301;
    stroke-width: 1.9;
    stroke-linejoin: round;
    transform-origin: center;
    animation: starcta-glint 6s ease-in-out infinite;
  }
  .starcta__btn:hover .starcta__star,
  .starcta__btn:focus-visible .starcta__star {
    fill: #f5b301;
    stroke-width: 0;
    animation: starcta-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes starcta-glint {
    0%,
    88%,
    100% {
      opacity: 0.85;
    }
    94% {
      opacity: 1;
    }
  }
  @keyframes starcta-pop {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.28) rotate(-8deg);
    }
    100% {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No movement, and no dependence on it either: the star is simply shown
       already filled, which is the state the animation was travelling towards. */
    .starcta__btn,
    .starcta__btn:hover,
    .starcta__btn:focus-visible {
      transition: none;
      transform: none;
    }
    .starcta__star,
    .starcta__btn:hover .starcta__star,
    .starcta__btn:focus-visible .starcta__star {
      animation: none;
      fill: #f5b301;
      stroke-width: 0;
      opacity: 1;
    }
  }
</style>
