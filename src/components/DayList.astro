---
/**
 * Lists days honestly: authored days link to their page with a status badge;
 * unwritten days render as plain text labelled "planned" — never a dead link,
 * never fake completion (requirements §13, design decision 4).
 */
import type { DayContext } from '../lib/curriculum';

interface Props {
  days: DayContext[];
}

const { days } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ol class="day-list">
  {
    days.map((d) => (
      <li>
        <span class="num">Day {String(d.number).padStart(3, '0')}</span>
        {d.hasContent ? (
          <a href={`${base}/${d.dayId}`}>{d.title}</a>
        ) : (
          <span>{d.title}</span>
        )}
        <span class={`badge ${d.status}`}>{d.status}</span>
      </li>
    ))
  }
</ol>
