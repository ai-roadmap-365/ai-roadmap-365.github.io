---
/**
 * Accessible quiz rendered from quiz.yml. Works with no JavaScript at all:
 * each question is a <details> disclosure containing the answer and
 * explanation, fully keyboard-navigable, and expanded automatically in the
 * print view. This same data is rendered as static HTML by the WordPress
 * export (scripts/release/render-lesson.mjs) so both stay in sync.
 */
import type { QuizQuestion } from '../lib/curriculum';

interface Props {
  questions: QuizQuestion[];
}

const { questions } = Astro.props;
const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
---

<section aria-label="Quiz">
  {
    questions.map((q, i) => (
      <div class="quiz-question">
        <p>
          <strong>
            Q{i + 1}. {q.question}
          </strong>
        </p>
        <ol type="A">
          {q.options.map((opt) => (
            <li>{opt}</li>
          ))}
        </ol>
        <details>
          <summary>Show answer</summary>
          <p>
            <strong>Answer: {letters[q.answer_index]}.</strong> {q.options[q.answer_index]}
          </p>
          <p>{q.explanation}</p>
        </details>
      </div>
    ))
  }
</section>
