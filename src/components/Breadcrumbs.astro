---
import type { DayContext } from '../lib/curriculum';

interface Props {
  day: DayContext;
}

const { day } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<p class="crumbs" aria-label="Breadcrumb">
  <a href={`${base}/sections/${day.section}`}>{day.sectionTitle}</a>
  {' › '}
  <span>{day.weekTheme}</span>
  {' › '}
  Day {day.number}
</p>
