---
/**
 * Lesson navigation as two distinct cards rather than one run-on line.
 *
 * The previous version put both links in a single row of text, so "Day 1: How
 * a Computer Works" and "Day 3: Memory Hierarchy" ran together and read as one
 * sentence. They are now two cards with different treatments: previous is
 * quiet and outlined, next is the accented one, because moving forward is what
 * a reader almost always wants and the eye should land on it.
 *
 * These deliberately navigate in place — you are choosing to move on, so a new
 * tab would be wrong here (unlike the content links, which open in one).
 */
import type { DayContext } from '../lib/curriculum';

interface Props {
  prev?: DayContext;
  next?: DayContext;
}

const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="pn" aria-label="Lesson navigation">
  {
    prev ? (
      prev.hasContent ? (
        <a class="pn__card pn__card--prev" href={`${base}/${prev.dayId}`}>
          <span class="pn__dir">← Previous · Day {prev.number}</span>
          <span class="pn__title">{prev.title}</span>
        </a>
      ) : (
        <span class="pn__card pn__card--prev pn__card--planned">
          <span class="pn__dir">← Previous · Day {prev.number}</span>
          <span class="pn__title">
            {prev.title} <em>(planned)</em>
          </span>
        </span>
      )
    ) : (
      <span class="pn__spacer" />
    )
  }

  {
    next ? (
      next.hasContent ? (
        <a class="pn__card pn__card--next" href={`${base}/${next.dayId}`}>
          <span class="pn__dir">Next · Day {next.number} →</span>
          <span class="pn__title">{next.title}</span>
        </a>
      ) : (
        <span class="pn__card pn__card--next pn__card--planned">
          <span class="pn__dir">Next · Day {next.number} →</span>
          <span class="pn__title">
            {next.title} <em>(planned)</em>
          </span>
        </span>
      )
    ) : (
      <span class="pn__spacer" />
    )
  }
</nav>

<style>
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 32px 0 8px;
  }
  @media (max-width: 720px) {
    .pn {
      grid-template-columns: 1fr;
    }
  }

  .pn__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .pn__card:hover {
    transform: translateY(-2px);
  }

  /* Previous: quiet. You have already read it. */
  .pn__card--prev {
    background: color-mix(in srgb, var(--fg, #e2e8f0) 4%, transparent);
    align-items: flex-start;
    text-align: left;
  }
  .pn__card--prev:hover {
    border-color: color-mix(in srgb, var(--fg, #e2e8f0) 28%, transparent);
  }

  /* Next: the accented one, because forward is where the reader is going. */
  .pn__card--next {
    background: color-mix(in srgb, var(--accent, #1d4ed8) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent, #1d4ed8) 45%, transparent);
    align-items: flex-end;
    text-align: right;
  }
  .pn__card--next:hover {
    background: color-mix(in srgb, var(--accent, #1d4ed8) 20%, transparent);
    border-color: var(--accent, #1d4ed8);
  }

  .pn__dir {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, #94a3b8);
  }
  .pn__card--next .pn__dir {
    color: var(--accent-soft, #7dd3fc);
  }

  .pn__title {
    font-weight: 650;
    line-height: 1.35;
    color: var(--fg, #e2e8f0);
  }

  .pn__card--planned {
    opacity: 0.6;
    cursor: default;
  }
  .pn__card--planned:hover {
    transform: none;
  }
  .pn__card--planned em {
    font-style: normal;
    color: var(--muted, #94a3b8);
    font-weight: 400;
  }

  .pn__spacer {
    display: block;
  }
</style>
