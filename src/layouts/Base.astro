---
import '../styles/global.css';
import { loadConfig } from '../lib/config';

interface Props {
  title: string;
  description?: string;
  /** Home sets this so the <title> is not "Home · 365 Days of AI Mastery". */
  bareTitle?: boolean;
  /**
   * Path (relative to the site root) of the image a shared link should show.
   * A day page passes its own hero — the same image the page opens with — so
   * the preview card and the page can never disagree.
   */
  image?: string;
}

const {
  title,
  description = 'A year-long, hands-on path from computing foundations to shipping production AI systems — one lesson and one lab every day.',
  bareTitle = false,
  image = 'social/cover.png',
} = Astro.props;

const config = loadConfig();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = config.website.public_base_url ?? base;
const canonical = new URL(Astro.url.pathname, site).href;
const pageTitle = bareTitle ? title : `${title} · ${config.course.title}`;
// Absolute, because every crawler that reads og:image requires it to be.
const ogImage = new URL(`${base}/${image}`, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.course.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.course.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#129504;</text></svg>"
    />
    <script is:inline>
      // Dark is the default regardless of OS preference - this is a dark-first
      // design. A visitor who picks light with the toggle keeps it. Applied
      // before first paint so there is no flash of the wrong theme.
      (() => {
        let t;
        try {
          t = localStorage.getItem('theme');
        } catch {
          t = null;
        }
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="site-home" href="https://sandeepbazar.github.io/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
        Sandeep Bazar
      </a>

      <a class="brand" href={`${base}/`}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <defs>
            <linearGradient id="bg1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#6f6cf6"></stop>
              <stop offset="1" stop-color="#38bdf8"></stop>
            </linearGradient>
          </defs>
          <circle cx="16" cy="16" r="12.5" fill="url(#bg1)" opacity=".2"></circle>
          <circle cx="16" cy="16" r="12.5" fill="none" stroke="url(#bg1)" stroke-width="1.8"
          ></circle>
          <path
            d="M16 8.5v7.8l5 3"
            fill="none"
            stroke="#38bdf8"
            stroke-width="2.2"
            stroke-linecap="round"></path>
        </svg>
        365 Days of AI
      </a>

      <nav aria-label="Primary">
        <a href={`${base}/sections`}>Courses</a>
        <a href={`${base}/search`}>Search</a>
        <a href={`${base}/glossary`}>Glossary</a>
        <a href={`${base}/progress`}>Progress</a>
      </nav>

      <div class="spacer"></div>

      <button class="iconbtn" id="theme" type="button" aria-label="Toggle colour theme">
        <svg
          class="theme-light-only"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
          ></path>
        </svg>
        <svg
          class="theme-dark-only"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"></path>
        </svg>
      </button>

      <a class="ghlink" href={config.repository.public_url}>
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
          ></path>
        </svg>
        Labs
      </a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <span>
          {config.course.title} · by {config.course.author} · lessons and labs are free to use
        </span>
        <nav>
          <a href={config.repository.public_url}>Labs on GitHub</a>
          <a href="https://sandeepbazar.github.io/blogs/">Writing</a>
          <a href="https://ocm-mcp-server.github.io/ocm-mcp-server/">ocm-mcp-server</a>
          <a href="https://www.linkedin.com/in/sandeepbazar/">LinkedIn</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      // Progressive enhancement only: the theme falls back to dark and every
      // .reveal element is visible by default (the hidden start state exists
      // only inside a prefers-reduced-motion: no-preference query).
      (() => {
        const toggle = document.getElementById('theme');
        if (toggle) {
          toggle.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
            document.documentElement.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {
              /* private mode */
            }
          });
        }

        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll('.reveal');
        if (items.length && !reduced && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry, i) => {
                if (!entry.isIntersecting) return;
                entry.target.style.transitionDelay = `${Math.min(i * 50, 240)}ms`;
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
          );
          items.forEach((el) => io.observe(el));
        } else {
          items.forEach((el) => el.classList.add('is-in'));
        }
      })();
    </script>
  </body>
</html>
